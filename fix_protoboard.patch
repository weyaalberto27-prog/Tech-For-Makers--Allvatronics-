       if (comp.componentType === "ground") {
         groundNodes.add(ids[0]);
       }
+      
+      if (comp.componentType === "protoboard") {
+        // Middle top columns
+        for (let col = 0; col < 60; col++) {
+          for (let row = 0; row < 4; row++) {
+            addWireEdge(pins[col + row * 60], pins[col + (row + 1) * 60]);
